# EcoSort Backend Configuration (.env.example)

# Port and Host
ECOSORT_HOST=127.0.0.1
ECOSORT_PORT=8000

# Security Secrets (Generate a strong 256-bit random string in production)
ECOSORT_JWT_SECRET=replace_with_a_secure_random_secret_in_production

# Optional Cloud Vision AI Providers (Leave blank for transparent offline demonstration fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./ecosort.db
